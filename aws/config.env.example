# Copy to aws/config.env (gitignored) and edit. Read by every script in aws/ and by start/stop/cleanup.sh.
REGION=us-east-1
AZ=us-east-1a
PROJECT=papermill                 # prefix for every resource name + tag Project=$PROJECT
INSTANCE_TYPE=r5.large            # 3 identical, non-burstable nodes
SLOTS=2                           # MPI slots per node in /data/hosts (= vCPUs)
DISK_GB=50
HTTP_PORT=8000                    # optional web front end on the master (MASTER_CMD)
HTTP_ALLOW_CIDRS=""               # extra CIDRs (space-separated) allowed to HTTP_PORT besides your own IP
MASTER_CMD=""                     # optional command run as mpiuser in the master container
SHARD_BUCKET=my-shard-bucket      # s3://$SHARD_BUCKET/$SHARD_PREFIX/shard-NNN.jsonl.gz
SHARD_PREFIX=""
SHARDS="0 1 2 3"                  # shard numbers to copy to every node
DATA_SRC=./data                   # local dir with settings.txt (+ optional extra.jsonl), copied to /data on every node
